  hrqde:refersToOccupation       esco-occupation:258e46f9-0075-4a2e-adae-1ff0477e0f30 ;
  hrqde:sourceUrl                "https://example.com/jobs/datalabs/data-scientist"^^xsd:anyURI ;
  hrqde:hasRequirement           sitzler:req_b7d2e4f5_python ,
                                 sitzler:req_b7d2e4f5_ml ,
                                 sitzler:req_b7d2e4f5_stats ,
                                 sitzler:req_b7d2e4f5_sql .

