  hrqde:requirementKind          "must" ;
  hrqde:provenanceConfidence     "0.92"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .

sitzler:req_b7d2e4f5_ml
  a                              hrqde:QualificationRequirement ;
  hrqde:refersToCompetence       esco-skill:19a8293b-8e95-4de3-983f-77484079c389 ;
  hrqde:requiredLevel            hrqde:DQR7 ;
  hrqde:requirementKind          "must" ;
  hrqde:provenanceConfidence     "0.95"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .

sitzler:req_b7d2e4f5_stats
  a                              hrqde:QualificationRequirement ;
  hrqde:refersToCompetence       esco-skill:ce8ae6ca-61d8-4174-b457-641de96cbff4 ;
  hrqde:requiredLevel            hrqde:DQR6 ;
  hrqde:requirementKind          "must" ;
  hrqde:provenanceConfidence     "0.85"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .

sitzler:req_b7d2e4f5_sql
  a                              hrqde:QualificationRequirement ;
  hrqde:refersToCompetence       esco-skill:11430d93-c835-48ed-8e70-285fa69c9ae6 ;
  hrqde:requiredLevel            hrqde:DQR5 ;
  hrqde:requirementKind          "nice_to_have" ;
  hrqde:provenanceConfidence     "0.78"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .


