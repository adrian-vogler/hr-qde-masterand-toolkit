# =====================================================================
# Example Delivery — Säule C (Sitzler) · Demand-Profile
# Version 0.1.1  ·  2026-05-13
#
# Three exemplary job postings demonstrating a conformant delivery
# against hrqde-shape-demand.ttl.
#
# v0.1.1: requirementKind values changed from "nice-to-have" to
# "nice_to_have" to match the shape's controlled vocabulary (which
# in turn avoids a neosemantics Cypher-generator collision with the
# hyphen as subtraction operator).
# =====================================================================

@prefix hrqde:           <http://hr-qde.org/ontology/> .
@prefix sitzler:         <http://hr-qde.org/data/sitzler/> .
@prefix employer:        <http://hr-qde.org/data/sitzler/employer/> .
@prefix esco-skill:      <http://data.europa.eu/esco/skill/> .
@prefix esco-occupation: <http://data.europa.eu/esco/occupation/> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .


employer:techcorp
  a                  hrqde:Employer ;
  rdfs:label         "TechCorp GmbH"@de .

employer:datalabs
  a                  hrqde:Employer ;
  rdfs:label         "DataLabs AG"@de .

employer:startupxy
  a                  hrqde:Employer ;
  rdfs:label         "StartUpXY UG"@de .


# JobPosting 1 — Senior Python Developer (TechCorp) ===================

sitzler:posting_a8f3c2e1
  a                              hrqde:JobPosting ;
  hrqde:postingDate              "2026-04-22"^^xsd:date ;
  hrqde:issuedBy                 employer:techcorp ;
  hrqde:sourceUrl                "https://example.com/jobs/techcorp/senior-python-dev"^^xsd:anyURI ;
  hrqde:hasRequirement           sitzler:req_a8f3c2e1_python ,
                                 sitzler:req_a8f3c2e1_databases ,
                                 sitzler:req_a8f3c2e1_ml .

sitzler:req_a8f3c2e1_python
  a                              hrqde:QualificationRequirement ;
  hrqde:refersToCompetence       esco-skill:ccd0a1d9-afda-43d9-b901-96344886e14d ;
  hrqde:requiredLevel            hrqde:DQR6 ;
  hrqde:requirementKind          "must" ;
  hrqde:provenanceConfidence     "0.95"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .

sitzler:req_a8f3c2e1_databases
  a                              hrqde:QualificationRequirement ;
  hrqde:refersToCompetence       esco-skill:ab1e97ed-2319-4293-a8b7-072d2648822f ;
  hrqde:requiredLevel            hrqde:DQR5 ;
  hrqde:requirementKind          "must" ;
  hrqde:provenanceConfidence     "0.88"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .

sitzler:req_a8f3c2e1_ml
  a                              hrqde:QualificationRequirement ;
  hrqde:refersToCompetence       esco-skill:19a8293b-8e95-4de3-983f-77484079c389 ;
  hrqde:requiredLevel            hrqde:DQR5 ;
  hrqde:requirementKind          "nice_to_have" ;
  hrqde:provenanceConfidence     "0.75"^^xsd:decimal ;
  hrqde:provenanceSource         "job_posting" .


# JobPosting 2 — Datenwissenschaftler (DataLabs, with ESCO occupation)

sitzler:posting_b7d2e4f5
